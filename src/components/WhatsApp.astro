---
// Floating WhatsApp Business Button — no props needed
---

<a 
  href="https://wa.me/971528099319" 
  target="_blank" 
  rel="noopener noreferrer"
  aria-label="Contact via WhatsApp Business"
  class="whatsapp-float"
  style="right:24px;"
>
  <!-- WhatsApp Business mark: WhatsApp speech bubble + the "B" wordmark -->
  <svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path fill="white" fill-rule="evenodd" d="M12.051 21.785h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884M20.464 3.488A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    <path fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M9.7 7.55v8.7M9.7 7.55h2.1a2.175 2.175 0 0 1 0 4.35H9.7M9.7 11.9h2.5a2.175 2.175 0 0 1 0 4.35H9.7"/>
  </svg>
</a>

<style>
  /* Ensure WhatsApp button has safe area spacing on mobile */
  @supports (padding: max(0px)) {
    .whatsapp-float {
      bottom: max(24px, env(safe-area-inset-bottom, 24px)) !important;
      right: max(24px, env(safe-area-inset-right, 24px)) !important;
    }
  }
  @media (max-width: 480px) {
    .whatsapp-float {
      width: 48px !important;
      height: 48px !important;
      bottom: max(16px, env(safe-area-inset-bottom, 16px)) !important;
      right: max(16px, env(safe-area-inset-right, 16px)) !important;
    }
    .whatsapp-float svg {
      width: 24px !important;
      height: 24px !important;
    }
  }
