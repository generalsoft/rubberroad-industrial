---
export interface Props {
  videoSrc: string;
  buttonLabel: string;
  lang: string;
}

const { videoSrc, buttonLabel, lang } = Astro.props;
const isAr = lang === "ar";
const uid = "vm-" + Math.random().toString(36).slice(2, 9);
---

<button class="btn btn-video video-trigger" data-video-src={videoSrc} data-uid={uid}>
  <svg class="play-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <polygon points="5 3 19 12 5 21 5 3" fill="currentColor"/>
  </svg>
  {buttonLabel}
</button>

<div class="video-overlay" data-uid={uid} style="display:none;">
  <div class="video-overlay-bg"></div>
  <div class="video-overlay-content">
    <button class="video-close-btn">
      {isAr ? '✕ إغلاق' : '✕ Close'}
    </button>
    <video controls preload="metadata" class="video-modal-player">
      {isAr ? 'متصفحك لا يدعم تشغيل الفيديو.' : 'Your browser does not support the video tag.'}
    </video>
  </div>
</div>

<style>
  .video-trigger {
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border-color: var(--green) !important;
    color: var(--green) !important;
    background: transparent !important;
    position: relative;
    animation: pulse-glow 2s ease-in-out infinite;
  }
  .video-trigger:hover {
    background: var(--green) !important;
    color: var(--black) !important;
    animation: none;
  }
  .play-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }
  @keyframes pulse-glow {
    0%, 100% {
      box-shadow: 0 0 0 0 rgba(126, 211, 33, 0.4);
      border-color: var(--green);
    }
    50% {
      box-shadow: 0 0 0 8px rgba(126, 211, 33, 0);
      border-color: var(--green-dim);
    }
  }
  .video-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2147483647;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    isolation: isolate;
  }
  .video-overlay-bg {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.85);
    backdrop-filter: blur(6px);
  }
  .video-overlay-content {
    position: relative;
    width: 100%;
    max-width: 800px;
    max-height: 90vh;
    z-index: 1;
    display: flex;
    flex-direction: column;
  }
  .video-close-btn {
    position: absolute;
    top: -40px;
    right: 0;
    background: none;
    border: none;
    color: var(--paper);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    cursor: pointer;
    padding: 8px 12px;
    transition: color .2s;
    z-index: 2;
    white-space: nowrap;
  }
  .video-close-btn:hover {
    color: var(--green);
  }
  .video-modal-player {
    width: 100%;
    height: auto;
    max-height: 85vh;
    border-radius: 8px;
    border: 1px solid var(--line);
    display: block;
    object-fit: contain;
    background: #000;
  }
  [dir="rtl"] .video-close-btn {
    right: auto;
    left: 0;
  }
  @media (max-width: 640px) {
    .video-overlay {
      padding: 12px;
    }
    .video-close-btn {
      top: -36px;
      font-size: 0.78rem;
    }
    .video-modal-player {
      max-height: 70vh;
      border-radius: 6px;
    }
  }


</style>

<script>
  function lockBodyScroll(lock) {
    if (lock) {
      document.body.style.overflow = 'hidden';
      document.body.style.position = 'fixed';
      document.body.style.top = '0';
      document.body.style.left = '0';
      document.body.style.right = '0';
      document.body.style.bottom = '0';
    } else {
      document.body.style.overflow = '';
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.left = '';
      document.body.style.right = '';
      document.body.style.bottom = '';
    }
  }

  function closeOverlay(overlay) {
    if (!overlay) return;
    overlay.style.display = 'none';
    lockBodyScroll(false);
    var video = overlay.querySelector('video');
    if (video) {
      video.pause();
      video.removeAttribute('src');
      video.load();
    }
  }

  document.addEventListener('click', function(e) {
    // Find trigger button
    var trigger = e.target.closest('.video-trigger');
    if (trigger) {
      var uid = trigger.getAttribute('data-uid');
      var src = trigger.getAttribute('data-video-src');
      var overlay = document.querySelector('.video-overlay[data-uid="' + uid + '"]');
      if (overlay && src) {
        var video = overlay.querySelector('video');
        if (video) {
          // Move overlay to body to escape any parent stacking contexts
          if (overlay.parentNode !== document.body) {
            document.body.appendChild(overlay);
          }
          video.src = src;
          overlay.style.display = 'flex';
          lockBodyScroll(true);
          video.currentTime = 0;
          video.play()['catch'](function(){});
        }
      }
      return;
    }

    // Find close button
    var closeBtn = e.target.closest('.video-close-btn');
    if (closeBtn) {
      closeOverlay(closeBtn.closest('.video-overlay'));
      return;
    }

    // Click on background
    var bg = e.target.closest('.video-overlay-bg');
    if (bg) {
      closeOverlay(bg.closest('.video-overlay'));
    }
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      var overlay = document.querySelector('.video-overlay[style*="flex"]');
      closeOverlay(overlay);
    }
  });
</script>

