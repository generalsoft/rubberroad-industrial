---
export interface Props { lang: string; }
const { lang } = Astro.props;
const isAr = lang === "ar";
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;
---

<div class={`qr-strip ${isAr ? 'qr-strip-left' : 'qr-strip-right'}`} style={`${isAr ? 'left:20px;' : 'right:20px;'}`}>
  <div class="qr-item">
    <img src={base + "/images/qr/website.png"} alt="Website QR" />
    <span class="qr-label">{isAr ? 'الموقع' : 'Web'}</span>
    <img src={base + "/images/qr/website.png"} alt="Website QR Large" class="qr-preview" />
  </div>
  <div style="width:100%;height:1px;background:var(--line);"></div>
  <div class="qr-item">
    <img src={base + "/images/qr/Contact.png"} alt="Contact QR" />
    <span class="qr-label">{isAr ? 'اتصال' : 'Contact'}</span>
    <img src={base + "/images/qr/Contact.png"} alt="Contact QR Large" class="qr-preview" />
  </div>
  <div style="width:100%;height:1px;background:var(--line);"></div>
  <div class="qr-item">
    <img src={base + "/images/qr/Location.png"} alt="Location QR" />
    <span class="qr-label">{isAr ? 'الموقع' : 'Loc'}</span>
    <img src={base + "/images/qr/Location.png"} alt="Location QR Large" class="qr-preview" />
  </div>
</div>
