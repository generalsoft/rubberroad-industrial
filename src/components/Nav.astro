---
export interface Props { lang: string; dir: string; }
const { lang, dir } = Astro.props;
const { translations } = await import("../i18n/translations");
const t = translations[lang];
const isAr = lang === "ar";
---

<nav id="nav">
  <div></div>
  <ul id="nav-links">
    <li><a href={`/${lang}/`} onclick="closeMenu()">{t.nav.story}</a></li>
    <li><a href={`/${lang}/material/`} onclick="closeMenu()">{t.nav.material}</a></li>
    <li><a href={`/${lang}/industries/`} onclick="closeMenu()">{t.nav.industries}</a></li>
    <li><a href={`/${lang}/products/`} onclick="closeMenu()">{t.nav.products}</a></li>
    <li><a href={`/${lang}/trust/`} onclick="closeMenu()">{t.nav.trust}</a></li>
    <li><a href={`/${lang}/contact/`} class="nav-cta" onclick="closeMenu()">{t.nav.getQuote}</a></li>
      <li><a href={`/${lang === 'en' ? 'ar' : 'en'}/`} class="nav-lang">{lang === 'en' ? 'العربية' : 'English'}</a></li>
  </ul>
  <!-- Hamburger button -->
  <button class="burger" id="burger-btn" style="
    display:none;
    background:none;
    border:none;
    cursor:pointer;
    flex-direction:column;
    gap:5px;
    padding:5px;
    -webkit-tap-highlight-color:transparent;
    touch-action:manipulation;
  " onclick="toggleMenu()" aria-label="Toggle navigation menu">
    <span style="display:block;width:24px;height:2px;background:var(--green);transition:all .3s;"></span>
    <span style="display:block;width:24px;height:2px;background:var(--green);transition:all .3s;"></span>
    <span style="display:block;width:24px;height:2px;background:var(--green);transition:all .3s;"></span>
  </button>
</nav>
