---
export interface Props { lang: string; dir: string; }
const { lang, dir } = Astro.props;
const { translations } = await import("../i18n/translations");
const t = translations[lang];
const isAr = lang === "ar";
---

<footer>
  <div class="wrap" style="display:flex;justify-content:space-between;width:100%;flex-wrap:wrap;gap:12px;">
    <span>© <span id="yr"></span> {t.footer.left}</span>
    <span style="font-size:0.82rem;color:var(--green);letter-spacing:0.04em;">{t.footer.right}</span>
    <span style="font-size:0.65rem;opacity:0.6;">
      {isAr ? 'طور بواسطة' : 'Developed by'}{' '}
      <a
        href={isAr ? 'https://generalsoft.ae/ar/' : 'https://generalsoft.ae/en/'}
        target="_blank"
        rel="noopener noreferrer"
        style="color:var(--green);text-decoration:none;"
        onmouseover="this.style.textDecoration='underline'"
        onmouseout="this.style.textDecoration='none'"
      >Generalsoft</a>
    </span>
  </div>
</footer>
