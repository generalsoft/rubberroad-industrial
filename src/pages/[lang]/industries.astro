---
export async function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "ar" } }];
}

import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import QRStrip from "../../components/QRStrip.astro";
import WhatsApp from "../../components/WhatsApp.astro";

const lang = Astro.params.lang || "en";
const dir = lang === "ar" ? "rtl" : "ltr";
const { translations } = await import("../../i18n/translations");
const t = translations[lang];
const isAr = lang === "ar";
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;

const industryKeywords = isAr
  ? ["مطارات", "سيارات", "موانئ", "سكك حديدية", "مصانع", "نفط وغاز", "طرق", "بحرية", "إنشاءات", "لوجستيات"]
  : ["AVIATION", "AUTOMOTIVE", "MARITIME", "RAIL", "OIL & GAS", "CONSTRUCTION", "LOGISTICS", "MANUFACTURING", "INFRASTRUCTURE", "DEFENCE"];
---

<Layout
  title={`${t.nav.industries} — Rubber Road Industrial`}
  lang={lang}
  dir={dir}
  description="From airports to oil & gas, railways to sea ports — Rubber Road Industrial supplies engineered rubber components across 9+ industries in the Gulf and MENA."
  canonical={`https://v2.rubberroad-industrial.com/${lang}/industries/`}
>
  <div class="page-bg" style="background-image:url('/images/background/industries.png');"></div>
  <Nav lang={lang} dir={dir} />

  <!-- Industry keyword marquee strip -->
  <div class="marquee-strip" style="margin-top:90px;">
    <span set:html={industryKeywords.map(kw => `${kw}  <b>•</b>  `).join('') + industryKeywords.map(kw => `${kw}  <b>•</b>  `).join('')}>
    </span>
  </div>

  <section class="industries" style="padding-top:60px;">
    <div class="wrap">
      <div class="section-head anim-up">
        <h2>{t.industries.title}</h2>
        <p>{t.industries.subtitle}</p>
      </div>
      <div class="ind-grid anim-up anim-up-d1">
        {
          t.industries.items.map((item, index) => (
            <div class="ind-card content-panel">
              <span class="num">{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h4>{item.name}</h4>
                <p>{item.desc}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <QRStrip lang={lang} />
  <WhatsApp />
  <Footer lang={lang} dir={dir} />
</Layout>

<style>
  .ind-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .ind-card {
    padding: 30px 26px !important;
    min-height: 200px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    cursor: default;
    transition: border-color 0.35s, transform 0.35s, box-shadow 0.35s !important;
  }
  .ind-card:hover {
    transform: translateY(-6px) !important;
    border-color: var(--green) !important;
    box-shadow: 0 12px 40px rgba(126,211,33,0.08) !important;
  }
  .ind-card:hover h4 { color: var(--green); }
  .ind-card:hover p { color: var(--paper); }
  .ind-card .num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    color: var(--paper-dim);
  }
  .ind-card h4 {
    font-family: 'Big Shoulders Display';
    font-size: 1.4rem;
    font-weight: 700;
    margin: 14px 0 8px;
    transition: color 0.3s;
  }
  .ind-card p {
    font-size: 0.82rem;
    color: var(--paper-dim);
    line-height: 1.55;
    transition: color 0.3s;
  }
  @media (max-width: 980px) {
    .ind-grid { grid-template-columns: 1fr; }
  }
  @media (min-width: 981px) and (max-width: 1100px) {
    .ind-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>