---
export async function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "ar" } }];
}

import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import QRStrip from "../../components/QRStrip.astro";
import WhatsApp from "../../components/WhatsApp.astro";
import VideoModal from "../../components/VideoModal.astro";

const lang = Astro.params.lang || "en";
const dir = lang === "ar" ? "rtl" : "ltr";
const { translations } = await import("../../i18n/translations");
const t = translations[lang];
const isAr = lang === "ar";
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;
---

<Layout
  title={`${t.nav.story} — Rubber Road Industrial`}
  lang={lang}
  dir={dir}
  description="Discover the Bahou family's rubber manufacturing legacy — from Fawzi Bahou's first factory in Amman (1952) to Rubber Road Industrial in Ras Al Khaimah, UAE. Over seventy years of engineered rubber heritage."
  canonical={`https://v2.rubberroad-industrial.com/${lang}/story/`}
>
  <div class="page-bg" style="background-image:url('/images/background/timeline.png');"></div>
  <Nav lang={lang} dir={dir} />

  <section style="padding-top:140px;">
    <div class="wrap">
      <div class="section-head anim-up">
        <h2>{t.story.title}</h2>
        <p style="font-style:italic;">{t.story.subtitle}</p>
      </div>
      <div class="story-grid">
        <div class="story-text content-panel anim-up anim-up-d1">
          <p>{t.story.p1}</p>
          <p>{t.story.p2}</p>
          <p>{t.story.p3}</p>
          <div class="story-img-row">
            {['story1', 'story2'].map(img => (
              <div class="story-img">
                <img src={base + `/images/${lang}/${img}.png`} alt="Rubber Road Industrial heritage" loading="lazy" />
              </div>
            ))}
          </div>
          <div class="quote">
            {t.story.quote}
            <cite>{t.story.quoteCite}</cite>
          </div>
          <div style="margin-top:24px;display:flex;gap:12px;flex-wrap:wrap;">
            <VideoModal
              videoSrc={base + "/video/Industrial_transformation_video_…_202607080036.mp4"}
              buttonLabel={isAr ? 'شاهد الفيديو' : 'Watch the Video'}
              lang={lang}
            />
            <VideoModal
              videoSrc={base + "/video/3D_cube_with_logo_rotating.mp4"}
              buttonLabel={isAr ? 'شعار المكعب' : '3D Logo'}
              lang={lang}
            />
          </div>
        </div>
        <div class="timeline content-panel anim-up anim-up-d2">
          {
            t.story.timeline.map((item) => (
              <div class="t-item">
                <div class="yr">{item.year}</div>
                <div class="ttl">{item.title}</div>
                <div class="dsc">{item.desc}</div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <QRStrip lang={lang} />
  <WhatsApp />
  <Footer lang={lang} dir={dir} />
</Layout>

<style>
  .story-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 64px;
    align-items: start;
  }
  .story-text p {
    color: var(--paper-dim);
    line-height: 1.8;
    margin-bottom: 18px;
    font-size: 0.98rem;
  }
  .story-img-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin: 20px 0;
  }
  .story-img {
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
  }
  .story-img img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }
  .quote {
    margin-top: 28px;
    padding: 24px 26px;
    border-left: 3px solid var(--green);
    background: rgba(126,211,33,0.05);
    font-family: 'Big Shoulders Display';
    font-size: 1.25rem;
    font-weight: 600;
    text-transform: none;
    letter-spacing: 0;
    line-height: 1.35;
    border-radius: 0 6px 6px 0;
  }
  .quote cite {
    display: block;
    margin-top: 12px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    color: var(--green);
    text-transform: uppercase;
    letter-spacing: .1em;
    font-style: normal;
  }
  .timeline {
    position: relative;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 6px;
    bottom: 6px;
    width: 1px;
    background: linear-gradient(var(--green), var(--line));
  }
  .t-item {
    position: relative;
    padding: 0 0 40px 32px;
  }
  .t-item:last-child { padding-bottom: 0; }
  .t-item::before {
    content: '';
    position: absolute;
    left: -1px;
    top: 6px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--black);
    border: 2px solid var(--green);
  }
  .t-item .yr {
    font-family: 'Big Shoulders Display';
    font-weight: 800;
    font-size: 1.5rem;
    color: var(--green);
  }
  .t-item .ttl {
    font-size: 0.9rem;
    color: var(--paper);
    margin-top: 2px;
    font-weight: 600;
  }
  .t-item .dsc {
    font-size: 0.82rem;
    color: var(--paper-dim);
    margin-top: 4px;
    line-height: 1.5;
  }
  [dir="rtl"] .timeline::before { left: auto; right: 6px; }
  [dir="rtl"] .t-item { padding: 0 32px 40px 0; }
  [dir="rtl"] .t-item::before { left: auto; right: -1px; }
  [dir="rtl"] .quote { border-left: none; border-right: 3px solid var(--green); border-radius: 6px 0 0 6px; }
  @media (max-width: 980px) {
    .story-grid { grid-template-columns: 1fr; gap: 40px; }
  }
  @media (max-width: 600px) {
    .story-img-row { grid-template-columns: 1fr; }
  }
</style>