---
export async function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "ar" } }];
}

import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import QRStrip from "../../components/QRStrip.astro";
import WhatsApp from "../../components/WhatsApp.astro";
import VideoModal from "../../components/VideoModal.astro";

const lang = Astro.params.lang || "en";
const dir = lang === "ar" ? "rtl" : "ltr";
const { translations } = await import("../../i18n/translations");
const t = translations[lang];
const isAr = lang === "ar";
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;
---

<Layout
  title={`${t.nav.story} — Rubber Road Industrial`}
  lang={lang}
  dir={dir}
  description="Discover the Bahou family's rubber manufacturing legacy — from Fawzi Bahou's first factory in Amman (1952) to Rubber Road Industrial in Ras Al Khaimah, UAE. Over seventy years of engineered rubber heritage."
  canonical={`https://v2.rubberroad-industrial.com/${lang}/story/`}
>
  <div class="circuit-bg"></div>
  <Nav lang={lang} dir={dir} />

  <section class="story" style="padding-top:140px;">
    <div class="wrap">
      <div class="section-head reveal">
        <h2>{t.story.title}</h2>
        <p>{t.story.subtitle}</p>
      </div>
      <div class="story-grid">
        <div class="story-text reveal">
          <p>{t.story.p1}</p>
          <p>{t.story.p2}</p>
          <p>{t.story.p3}</p>
          <div class="story-img-row">
            <div class="story-img">
              <img src={base + `/images/${lang}/story1.png`} alt="Rubber Road Industrial heritage" loading="lazy" />
            </div>
            <div class="story-img">
              <img src={base + `/images/${lang}/story2.png`} alt="Rubber Road Industrial legacy" loading="lazy" />
            </div>
          </div>
          <div class="quote">
            {t.story.quote}
            <cite>{t.story.quoteCite}</cite>
          </div>
          <div class="hero-cta" style="margin-top:32px;">
            <VideoModal
              videoSrc={base + "/video/Industrial_transformation_video_…_202607080036.mp4"}
              buttonLabel={isAr ? 'شاهد الفيديو' : 'Watch the Video'}
              lang={lang}
            />
          </div>
        </div>
        <div class="timeline reveal">
          {
            t.story.timeline.map((item) => (
              <div class="t-item">
                <div class="yr">{item.year}</div>
                <div class="ttl">{item.title}</div>
                <div class="dsc">{item.desc}</div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <QRStrip lang={lang} />
  <WhatsApp />
  <Footer lang={lang} dir={dir} />
</Layout>

<style>
  .story-img-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 24px 0;
  }
  .story-img {
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
  }
  .story-img img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }
  @media (max-width: 600px) {
    .story-img-row {
      grid-template-columns: 1fr;
    }
  }
</style>
