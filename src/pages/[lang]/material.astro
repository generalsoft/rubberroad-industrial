---
export async function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "ar" } }];
}

import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import QRStrip from "../../components/QRStrip.astro";
import WhatsApp from "../../components/WhatsApp.astro";

const lang = Astro.params.lang || "en";
const dir = lang === "ar" ? "rtl" : "ltr";
const { translations } = await import("../../i18n/translations");
const t = translations[lang];
const isAr = lang === "ar";
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;
---

<Layout
  title={`${t.nav.material} — Rubber Road Industrial`}
  lang={lang}
  dir={dir}
  description="Rubber is in everything — it absorbs, flexes, protects, and returns. Explore over eight distinct rubber compound types and our in-house QC process at Rubber Road Industrial."
  canonical={`https://v2.rubberroad-industrial.com/${lang}/material/`}
>
  <div class="page-bg" style="background-image:url('/images/background/process_stages.png');"></div>
  <Nav lang={lang} dir={dir} />

  <section id="material" style="padding-top:140px;">
    <div class="wrap">
      <div class="material-intro anim-up">
        <div>
          <div class="eyebrow">{t.material.eyebrow}</div>
          <h2 style="font-size:clamp(2rem,4vw,3.2rem);margin-top:14px;">
            {t.material.title}
          </h2>
        </div>
        <div class="content-panel">
          <p style="color:var(--paper);line-height:1.8;font-size:1rem;margin-bottom:14px;">{t.material.p1}</p>
          <p style="color:var(--paper);line-height:1.8;font-size:1rem;margin-bottom:0;">{t.material.p2}</p>
        </div>
      </div>
      <div class="props anim-up anim-up-d1">
        {
          t.material.props.map((prop) => (
            <div class="prop">
              <div class="ic">{prop.name}</div>
              <div class="lb">{prop.desc}</div>
            </div>
          ))
        }
      </div>
      <div class="material-compounds anim-up anim-up-d2" style="margin-top:80px;">
        <div class="section-head" style="margin-bottom:28px;">
          <h2 style="font-size:clamp(1.8rem,4vw,3rem);">{isAr ? 'أنواع المركبات' : 'Compound Types'}</h2>
          <p>{isAr ? 'أكثر من ثمانية أنواع متميزة من مركبات المطاط، كل منها مصمم لخصائص مقاومة محددة.' : 'Over eight distinct rubber compound types, each engineered for specific resistance properties.'}</p>
        </div>
      </div>
      <div style="margin-top:100px;" class="anim-up anim-up-d3">
        <div class="section-head" style="margin-bottom:28px;">
          <h2 style="font-size:clamp(1.8rem,4vw,3rem);">
            {t.material.processTitle}
          </h2>
          <p>{t.material.processSub}</p>
        </div>
        <div class="process-belt">
          {
            t.material.process.map((stage, index) => (
              <div class="p-stage" data-n={String(index + 1).padStart(2, "0")}>
                <h4>{stage.name}</h4>
                <p>{stage.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- MARQUEE — Compound Types -->
  <div class="marquee-strip">
    <span>
      <span class="compound-tip" data-tip="Natural Rubber">NR</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Silicone Rubber">SI</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Ethylene Propylene Diene Monomer">EPDM</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Butyl Rubber (Isobutylene-Isoprene)">IIR</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Nitrile Butadiene Rubber">NBR</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Styrene Butadiene Rubber">SBR</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Polybutadiene Rubber">PBR</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Polyurethane">PU</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Fluoroelastomer (Viton®)">FKM</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Custom formulations engineered to your exact specifications">CUSTOM ENGINEERED COMPOUNDS</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Natural Rubber">NR</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Silicone Rubber">SI</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Ethylene Propylene Diene Monomer">EPDM</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Butyl Rubber (Isobutylene-Isoprene)">IIR</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Nitrile Butadiene Rubber">NBR</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Styrene Butadiene Rubber">SBR</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Polybutadiene Rubber">PBR</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Polyurethane">PU</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Fluoroelastomer (Viton®)">FKM</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Custom formulations engineered to your exact specifications">CUSTOM ENGINEERED COMPOUNDS</span> &nbsp;<b>•</b>&nbsp;
    </span>
  </div>

  <script>
    (function() {
      var popup = document.createElement('div');
      popup.className = 'compound-tip-popup';
      document.body.appendChild(popup);
      
      var hideTimeout = null;
      
      function showPopup(el) {
        var rect = el.getBoundingClientRect();
        var tip = el.getAttribute('data-tip');
        if (!tip) return;
        
        popup.textContent = tip;
        popup.style.top = (rect.top - 10) + 'px';
        popup.style.left = (rect.left + rect.width / 2) + 'px';
        popup.style.transform = 'translate(-50%, -100%)';
        popup.classList.add('visible');
      }
      
      function hidePopup() {
        popup.classList.remove('visible');
      }
      
      document.querySelectorAll('.marquee-strip .compound-tip').forEach(function(el) {
        el.addEventListener('mouseenter', function() {
          if (hideTimeout) { clearTimeout(hideTimeout); hideTimeout = null; }
          showPopup(el);
        });
        el.addEventListener('mouseleave', function() {
          hideTimeout = setTimeout(hidePopup, 100);
        });
      });
      
      popup.addEventListener('mouseenter', function() {
        if (hideTimeout) { clearTimeout(hideTimeout); hideTimeout = null; }
      });
      popup.addEventListener('mouseleave', function() { hidePopup(); });
    })();
  </script>

  <QRStrip lang={lang} />
  <WhatsApp />
  <Footer lang={lang} dir={dir} />
</Layout>

<style>
  .material-intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    margin-bottom: 80px;
    align-items: start;
  }
  .props {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
  }
  .prop {
    background: var(--panel-bg);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 28px 16px;
    text-align: center;
    transition: background 0.3s;
  }
  .prop:hover { background: rgba(126,211,33,0.06); }
  .prop .ic {
    font-family: 'Big Shoulders Display';
    font-weight: 900;
    font-size: 1.7rem;
    color: var(--green);
  }
  .prop .lb {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: .07em;
    color: var(--paper-dim);
    margin-top: 6px;
  }
  .process-belt {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    border-top: 1px dashed var(--line);
    padding-top: 0;
  }
  .p-stage {
    padding: 36px 18px 0;
    border-right: 1px dashed var(--line);
    position: relative;
  }
  .p-stage:last-child { border-right: none; }
  .p-stage::before {
    content: attr(data-n);
    position: absolute;
    top: -13px;
    left: 18px;
    width: 24px;
    height: 24px;
    background: var(--black);
    border: 1px solid var(--green);
    color: var(--green);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }
  .p-stage h4 {
    font-family: 'Big Shoulders Display';
    font-weight: 700;
    font-size: 1.1rem;
    text-transform: uppercase;
    margin-bottom: 8px;
    color: var(--paper);
  }
  .p-stage p {
    font-size: 0.84rem;
    color: var(--paper-dim);
    line-height: 1.55;
  }
  @media (max-width: 980px) {
    .material-intro { grid-template-columns: 1fr; gap: 40px; }
    .props { grid-template-columns: repeat(2, 1fr); }
    .process-belt { grid-template-columns: repeat(2, 1fr); }
    .p-stage { border-right: none; border-bottom: 1px dashed var(--line); padding-bottom: 20px; }
  }
  @media (max-width: 480px) {
    .props { grid-template-columns: 1fr 1fr; }
    .process-belt { grid-template-columns: 1fr; }
  }
</style>