---
export async function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "ar" } }];
}

import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import QRStrip from "../../components/QRStrip.astro";
import WhatsApp from "../../components/WhatsApp.astro";
import VideoModal from "../../components/VideoModal.astro";

const lang = Astro.params.lang || "en";
const dir = lang === "ar" ? "rtl" : "ltr";
const { translations } = await import("../../i18n/translations");
const t = translations[lang];
const isAr = lang === "ar";
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;
---

<Layout
  title="Rubber Road Industrial — Engineered Rubber Solutions, UAE"
  lang={lang}
  dir={dir}
  description="Rubber Road Industrial engineers high-performance rubber components for aviation, marine, rail, oil & gas, and industrial sectors across the Gulf and MENA — built on over seventy years of manufacturing heritage."
  canonical={`https://v2.rubberroad-industrial.com/${lang}/`}
>
  <div class="circuit-bg"></div>
  <Nav lang={lang} dir={dir} />

  <!-- HERO -->
  <header class="hero">
    <div class="hero-grid" style="align-items:start;">
      {isAr ? (
        <>
          <div style="display:flex;align-items:flex-start;justify-content:center;padding-top:80px;">
            <div style="width:100%;max-width:280px;opacity:0.9;">
              <img src={base + "/images/logo/Logo3D.png"} alt="Rubber Road Industrial" style="width:100%;height:auto;" />
            </div>
          </div>
          <div>
            <div class="eyebrow">{t.hero.eyebrow}</div>
            <h1 style="margin-top:18px;">
              <span class="outline">{t.hero.line1}</span><br>
              <span class="accent">{t.hero.line2}</span><br>
              {t.hero.line3}
            </h1>
            <p class="hero-sub">{t.hero.subtitle}</p>
            <div class="hero-cta">
              <a href={`/${lang}/products/`} class="btn btn-solid">{t.hero.viewProducts}</a>
              <a href={`/${lang}/contact/`} class="btn btn-ghost">{t.hero.requestQuote}</a>
              <VideoModal
                videoSrc={base + "/video/Industrial_transformation_video_…_202607080036.mp4"}
                buttonLabel={isAr ? 'شاهد الفيديو' : 'Watch Video'}
                lang={lang}
              />
            </div>
          </div>
        </>
      ) : (
        <>
          <div>
            <div class="eyebrow">{t.hero.eyebrow}</div>
            <h1 style="margin-top:18px;">
              <span class="outline">{t.hero.line1}</span><br>
              <span class="accent">{t.hero.line2}</span><br>
              {t.hero.line3}
            </h1>
            <p class="hero-sub">{t.hero.subtitle}</p>
            <div class="hero-cta">
              <a href={`/${lang}/products/`} class="btn btn-solid">{t.hero.viewProducts}</a>
              <a href={`/${lang}/contact/`} class="btn btn-ghost">{t.hero.requestQuote}</a>
              <VideoModal
                videoSrc={base + "/video/Industrial_transformation_video_…_202607080036.mp4"}
                buttonLabel={isAr ? 'شاهد الفيديو' : 'Watch Video'}
                lang={lang}
              />
            </div>
          </div>
          <div style="display:flex;align-items:flex-start;justify-content:center;padding-top:80px;">
            <div style="width:100%;max-width:280px;opacity:0.9;">
              <img 
                src={base + "/images/logo/Logo3D.png"} 
                alt="Rubber Road Industrial" 
                style="width:100%;height:auto;animation:rotateLogo 6s ease-in-out infinite;transform-style:preserve-3d;perspective:1000px;" 
              />
            </div>
          </div>
        </>
      )}
    </div>
    
    <div style="max-width:1280px;margin:0 auto;width:100%;padding:0 40px;margin-top:40px;">
      <div class="hero-meta" style="border-left:none;padding-left:0;border-top:1px solid var(--line);padding-top:20px;flex-direction:row;flex-wrap:wrap;display:flex;gap:40px;">
        <div><b>1952</b>{t.hero.meta1}</div>
        <div><b>03</b>{t.hero.meta2}</div>
        <div><b>8+</b>{t.hero.meta3}</div>
      </div>
    </div>
    
    <div class="scroll-cue"><div class="line"></div>{isAr ? 'اسفل' : 'Scroll'}</div>
  </header>

  <!-- MARQUEE -->
  <div class="marquee-strip">
    <span>
      NR &nbsp;<b>•</b>&nbsp; SI &nbsp;<b>•</b>&nbsp; EPDM &nbsp;<b>•</b>&nbsp;
      IIR &nbsp;<b>•</b>&nbsp; NBR &nbsp;<b>•</b>&nbsp; SBR &nbsp;<b>•</b>&nbsp;
      PBR &nbsp;<b>•</b>&nbsp; PU &nbsp;<b>•</b>&nbsp; FKM &nbsp;<b>•</b>&nbsp;
      CUSTOM ENGINEERED COMPOUNDS &nbsp;<b>•</b>&nbsp; NR &nbsp;<b>•</b>&nbsp;
      SI &nbsp;<b>•</b>&nbsp; EPDM &nbsp;<b>•</b>&nbsp; IIR &nbsp;<b>•</b>&nbsp;
      NBR &nbsp;<b>•</b>&nbsp; SBR &nbsp;<b>•</b>&nbsp; PBR &nbsp;<b>•</b>&nbsp;
      PU &nbsp;<b>•</b>&nbsp; FKM &nbsp;<b>•</b>&nbsp; CUSTOM ENGINEERED
      COMPOUNDS &nbsp;<b>•</b>&nbsp;
    </span>
  </div>

  <QRStrip lang={lang} />
  <WhatsApp />
  <Footer lang={lang} dir={dir} />
</Layout>
