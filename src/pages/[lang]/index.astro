---
export async function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "ar" } }];
}

import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import QRStrip from "../../components/QRStrip.astro";
import WhatsApp from "../../components/WhatsApp.astro";
import VideoModal from "../../components/VideoModal.astro";

const lang = Astro.params.lang || "en";
const dir = lang === "ar" ? "rtl" : "ltr";
const { translations } = await import("../../i18n/translations");
const t = translations[lang];
const isAr = lang === "ar";
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;
---

<Layout
  title="Rubber Road Industrial — Engineered Rubber Solutions, UAE"
  lang={lang}
  dir={dir}
  description="Rubber Road Industrial engineers high-performance rubber components for aviation, marine, rail, oil & gas, and industrial sectors across the Gulf and MENA — built on over seventy years of manufacturing heritage."
  canonical={`https://v2.rubberroad-industrial.com/${lang}/`}
>
  <div class="circuit-bg"></div>
  <Nav lang={lang} dir={dir} />

  <!-- HERO -->
  <header class="hero">
    <div class="hero-grid" style="align-items:start;">
      {isAr ? (
        <>
          <div style="display:flex;align-items:flex-start;justify-content:center;padding-top:80px;">
            <div style="width:100%;max-width:280px;opacity:0.9;" class="logo-3d-wrap">
              <img src={base + "/images/logo/3D_cube_with_textures_2K_202607090808.png"} alt="Rubber Road Industrial" class="logo-3d" />
            </div>
          </div>
          <div>
            <div class="eyebrow">{t.hero.eyebrow}</div>
            <h1 style="margin-top:18px;">
              <span class="outline">{t.hero.line1}</span><br>
              <span class="accent">{t.hero.line2}</span><br>
              {t.hero.line3}
            </h1>
            <p class="hero-sub">{t.hero.subtitle}</p>
            <div class="hero-cta">
              <a href={`/${lang}/products/`} class="btn btn-solid">{t.hero.viewProducts}</a>
              <a href={`/${lang}/contact/`} class="btn btn-ghost">{t.hero.requestQuote}</a>
              <VideoModal
                videoSrc={base + "/video/Industrial_transformation_video_…_202607080036.mp4"}
                buttonLabel={isAr ? 'اعرف المزيد' : 'Learn More'}
                lang={lang}
              />
            </div>
          </div>
        </>
      ) : (
        <>
          <div>
            <div class="eyebrow">{t.hero.eyebrow}</div>
            <h1 style="margin-top:18px;">
              <span class="outline">{t.hero.line1}</span><br>
              <span class="accent">{t.hero.line2}</span><br>
              {t.hero.line3}
            </h1>
            <p class="hero-sub">{t.hero.subtitle}</p>
            <div class="hero-cta">
              <a href={`/${lang}/products/`} class="btn btn-solid">{t.hero.viewProducts}</a>
              <a href={`/${lang}/contact/`} class="btn btn-ghost">{t.hero.requestQuote}</a>
              <VideoModal
                videoSrc={base + "/video/Industrial_transformation_video_…_202607080036.mp4"}
                buttonLabel={isAr ? 'اعرف المزيد' : 'Learn More'}
                lang={lang}
              />
            </div>
          </div>
          <div style="display:flex;align-items:flex-start;justify-content:center;padding-top:80px;">
            <div style="width:100%;max-width:280px;opacity:0.9;" class="logo-3d-wrap">
              <img 
                src={base + "/images/logo/3D_cube_with_textures_2K_202607090808.png"} 
                alt="Rubber Road Industrial" 
                class="logo-3d"
              />
            </div>
          </div>
        </>
      )}
    </div>
    
    <div style="max-width:1280px;margin:0 auto;width:100%;padding:0 40px;margin-top:40px;">
      <div class="hero-meta" style="border-left:none;padding-left:0;border-top:1px solid var(--line);padding-top:20px;flex-direction:row;flex-wrap:wrap;display:flex;gap:40px;">
        <div><b>1952</b>{t.hero.meta1}</div>
        <div><b>03</b>{t.hero.meta2}</div>
        <div><b>8+</b>{t.hero.meta3}</div>
      </div>
    </div>
    
    <div class="scroll-cue"><div class="line"></div>{isAr ? 'اسفل' : 'Scroll'}</div>
  </header>

  <!-- HOMEPAGE IMAGE STRIP -->
  <div class="home-img-strip reveal">
    <div class="home-img-item">
      <img src={base + `/images/${lang}/story1.png`} alt="Rubber Road Industrial" loading="lazy" />
    </div>
    <div class="home-img-item">
      <img src={base + `/images/${lang}/industries1.png`} alt="Industries served" loading="lazy" />
    </div>
    <div class="home-img-item">
      <img src={base + `/images/${lang}/process.png`} alt="Manufacturing process" loading="lazy" />
    </div>
    <div class="home-img-item">
      <img src={base + `/images/${lang}/ubiquitous.png`} alt="Rubber everywhere" loading="lazy" />
    </div>
  </div>

  <!-- MARQUEE -->
  <div class="marquee-strip">
    <span>
      <span class="compound-tip" data-tip="Natural Rubber">NR</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Silicone Rubber">SI</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Ethylene Propylene Diene Monomer">EPDM</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Butyl Rubber (Isobutylene-Isoprene)">IIR</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Nitrile Butadiene Rubber">NBR</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Styrene Butadiene Rubber">SBR</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Polybutadiene Rubber">PBR</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Polyurethane">PU</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Fluoroelastomer (Viton®)">FKM</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Custom formulations engineered to your exact specifications">CUSTOM ENGINEERED COMPOUNDS</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Natural Rubber">NR</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Silicone Rubber">SI</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Ethylene Propylene Diene Monomer">EPDM</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Butyl Rubber (Isobutylene-Isoprene)">IIR</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Nitrile Butadiene Rubber">NBR</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Styrene Butadiene Rubber">SBR</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Polybutadiene Rubber">PBR</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Polyurethane">PU</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Fluoroelastomer (Viton®)">FKM</span> &nbsp;<b>•</b>&nbsp;
      <span class="compound-tip" data-tip="Custom formulations engineered to your exact specifications">CUSTOM ENGINEERED COMPOUNDS</span> &nbsp;<b>•</b>&nbsp;
    </span>
  </div>

  <script>
    (function() {
      var popup = document.createElement('div');
      popup.className = 'compound-tip-popup';
      document.body.appendChild(popup);
      
      var hideTimeout = null;
      
      function showPopup(el) {
        var rect = el.getBoundingClientRect();
        var tip = el.getAttribute('data-tip');
        if (!tip) return;
        
        popup.textContent = tip;
        popup.style.top = (rect.top - 10) + 'px';
        popup.style.left = (rect.left + rect.width / 2) + 'px';
        popup.style.transform = 'translate(-50%, -100%)';
        popup.classList.add('visible');
      }
      
      function hidePopup() {
        popup.classList.remove('visible');
      }
      
      document.querySelectorAll('.marquee-strip .compound-tip').forEach(function(el) {
        el.addEventListener('mouseenter', function() {
          if (hideTimeout) {
            clearTimeout(hideTimeout);
            hideTimeout = null;
          }
          showPopup(el);
        });
        el.addEventListener('mouseleave', function() {
          hideTimeout = setTimeout(hidePopup, 100);
        });
      });
      
      popup.addEventListener('mouseenter', function() {
        if (hideTimeout) {
          clearTimeout(hideTimeout);
          hideTimeout = null;
        }
      });
      popup.addEventListener('mouseleave', function() {
        hidePopup();
      });
    })();
  </script>

  <QRStrip lang={lang} />
  <WhatsApp />
  <Footer lang={lang} dir={dir} />
</Layout>
